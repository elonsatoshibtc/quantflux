# QuantFlux environment. SIMULATION ONLY — never add live keys here.

# Execution mode is fixed to paper; the code refuses anything else.
QF_MODE=paper

# Optional: adjust synthetic fill parameters.
QF_STARTING_BALANCE_USDT=10000
QF_TAKER_FEE_BPS=10
QF_SLIPPAGE_BPS=5

# Webhook router (local only).
QF_WEBHOOK_HOST=127.0.0.1
QF_WEBHOOK_PORT=8787

# --- FORBIDDEN (the app will refuse to start if these are set) ---
# QF_LIVE_API_KEY=
# QF_LIVE_SECRET=
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
